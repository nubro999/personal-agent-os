# 수집기(Claude Code 세션, 2325 담당 건)를 돌려 한 일을 Task로 맞춘다. pao-tracker.timer가 30분마다 실행한다.
[Unit]
Description=Personal Agent OS activity trackers

[Service]
Type=oneshot
WorkingDirectory=%h/projects/personal-agent-os/backend
UnsetEnvironment=ANTHROPIC_API_KEY
ExecStart=%h/.local/bin/uv run --frozen python -m app.trackers
TimeoutStartSec=30min
