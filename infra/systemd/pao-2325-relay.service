# 2325 DB 를 서버 맥의 터널로 빌려 쓴다(127.0.0.1:13306, 13316). 이 PC 의 AWS 키가 막혔을 때
# pao-2325-tunnel 대신 켠다. 먼저 db_relay.py pair 로 짝을 지어야 한다. 둘을 같이 켜지 않는다(13316 이 겹친다).
[Unit]
Description=Personal Agent OS 2325 DB relay via server mac
Conflicts=pao-2325-tunnel.service

[Service]
ExecStart=/usr/bin/python3 %h/projects/personal-agent-os/infra/tunnel/db_relay.py connect
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
