# 보드 화면과 Task API (http://localhost:8000). 인증이 없으므로 127.0.0.1에만 띄운다.
[Unit]
Description=Personal Agent OS web app and task API

[Service]
WorkingDirectory=%h/projects/personal-agent-os/backend
ExecStart=%h/.local/bin/uv run --frozen uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
